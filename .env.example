# Copy to .env and fill in. Never commit .env.

# ── App (EXPO_PUBLIC_ vars are embedded in the bundle: anon key only) ─────────
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Edge Functions (set with `supabase secrets set`, never in the bundle) ─────
# Server-side embeddings, per docs/DECISIONS.md §10.3.
RAIL_EMBEDDING_ENDPOINT=
RAIL_EMBEDDING_API_KEY=
# Recorded on each row so a future model change knows what to re-embed.
RAIL_EMBEDDING_MODEL=siglip-base-patch16-224

# Optional. Background removal degrades to the original image if unset,
# rather than failing the import.
RAIL_BG_REMOVAL_ENDPOINT=
RAIL_BG_REMOVAL_API_KEY=

# ── Tests ────────────────────────────────────────────────────────────────────
# Required for the SQL/TypeScript colour parity test. Unset, that suite skips —
# which leaves the duplicated colour maths in migration 0012 unguarded, so CI
# must set it.
RAIL_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
