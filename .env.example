# Frontend (Vite) — required for live auth + admin Studio
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAILS=r.lyons1@icloud.com
VITE_STRIPE_PUBLISHABLE_KEY=

# Launch waitlist gate (default ON). Set to false when you announce / go live.
VITE_WAITLIST_MODE=true
# Local staff bypass password when Netlify functions aren't running
VITE_WAITLIST_BYPASS_SECRET=

# Optional: BodiesByBecca app store links (separate product — not Office unlock)
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Netlify Functions — required for production checkout + unlock + waitlist
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STUDIO_PRICE_SECRET=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

