{
  "name": "rail",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace @rail/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset && psql \"$SUPABASE_DB_URL\" -f supabase/seed/fixtures.sql"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
